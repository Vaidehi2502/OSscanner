# Used by `docker compose up` (docker-compose.yml reads a .env file in this
# same directory for variable substitution). Copy to .env and fill in real
# values if you want auth; leave unset to run without authentication.
#
# This is separate from backend/.env.example and frontend/.env.local -
# those matter when running the backend/frontend directly (see README);
# this one only matters for the Docker Compose path.

# Shared secret required in the X-API-Key header. Also gets baked into the
# frontend's build (Create React App inlines REACT_APP_* at build time),
# so if you change this after the first `docker compose up`, rebuild the
# frontend image (`docker compose build frontend`) for it to take effect.
API_KEY=

# Comma-separated list of origins allowed to call the API cross-origin.
# Defaults to http://localhost:3000 (where the frontend container is
# published) if unset. Never set this to "*".
CORS_ORIGINS=http://localhost:3000

# If set to a positive number of seconds, the backend container runs a scan
# automatically on that interval for as long as it's up. Leave unset for
# manual-only scanning (the default).
MONITOR_INTERVAL_SECONDS=
