# Copy to backend/.env and fill in real values, or export these directly in
# your shell before running app.py. There's no dotenv loader here (app.py
# reads via os.environ only), so a .env file by itself does nothing unless
# you load it yourself, e.g.:
#   export $(grep -v '^#' .env | xargs) && python3 app.py

# Shared secret required in the X-API-Key header for every /api/* route
# except /api/health. Leave unset/empty to run without authentication - a
# startup warning is printed, and fine for a quick local-only check, but
# don't leave it unset if this is reachable beyond your own machine.
API_KEY=

# Comma-separated list of origins allowed to call the API cross-origin.
# Defaults to http://localhost:3000 (the frontend dev server) if unset.
# Never set this to "*" - this API returns system-level details.
CORS_ORIGINS=http://localhost:3000

# Flask dev server settings. Shown here at their actual defaults - only
# change FLASK_DEBUG or FLASK_HOST if you know why you need to (see README):
# debug mode + a non-loopback host together expose an interactive console
# that can execute code.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Background live monitoring: if set to a positive number of seconds, a
# background thread runs a scan (same pipeline as POST /api/scan) on that
# interval for as long as the process is running, so history builds up
# automatically. Leave unset/empty to keep scans manual-only (the default).
# Only takes effect when running via `python3 app.py` directly (it's
# started from the __main__ block, not on import).
MONITOR_INTERVAL_SECONDS=

# Network threat detection: if set to 1, a background thread polls active
# network connections and flags matches against known-malicious IPs/ports
# (backend/rules/malicious_ips.json, malicious_ports.json), new external
# connections, and simple port-scan behavior. Detection/alerting only - it
# never blocks a connection or touches firewall rules. Leave unset/0 to
# keep network checks manual-only (the one-shot network/port scanners that
# already run as part of POST /api/scan). Only takes effect when running
# via `python3 app.py` directly.
NETWORK_THREAT_DETECTION=

# How often (seconds) the network threat detector polls connections when
# NETWORK_THREAT_DETECTION=1. Defaults to 5 if unset.
NETWORK_THREAT_POLL_SECONDS=
